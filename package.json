{
  "name": "live-trading-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal paper-trading simulator with live free market data. Fictional money only.",
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts --dev",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/server/main.js",
    "start": "node dist/server/main.js",
    "start:lan": "node dist/server/main.js --lan",
    "stop": "node scripts/stop.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "node scripts/test.mjs",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "decimal.js": "^10.4.3",
    "lightweight-charts": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^2.4.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "4.0.18"
  }
}
