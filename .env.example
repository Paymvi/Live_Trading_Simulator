# Copy to .env (git-ignored) or enter keys in Settings -> Providers.
# Free Alpaca account: https://app.alpaca.markets/signup  -> Paper Trading -> API Keys.
# Only market-data endpoints are ever called. No real orders are possible.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Optional overrides
# LTS_PORT=5180
# LTS_LAN_PORT=5181
# LTS_DATA_DIR=./data
